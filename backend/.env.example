# =============================================================================
# AI Chat Backend — copy to `.env` (never commit `.env`)
#
# Docker Compose (default): hostnames `postgres` and `redis` below.
# Local Python on host (Option B in README): uncomment the localhost lines.
# =============================================================================

# --- App ---
APP_NAME=AI Chat
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL (docker-compose postgres service) ---
POSTGRES_USER=ai_chat
POSTGRES_PASSWORD=ai_chat_pass
POSTGRES_DB=ai_chat

# Docker (api/worker inside compose network)
DATABASE_URL=postgresql+asyncpg://ai_chat:ai_chat_pass@postgres:5432/ai_chat
# Local Python on host:
# DATABASE_URL=postgresql+asyncpg://ai_chat:ai_chat_pass@localhost:5432/ai_chat

# --- Redis ---
REDIS_URL=redis://redis:6379/0
# Local Python on host:
# REDIS_URL=redis://localhost:6379/0

# --- LLM — Gemini (leave GEMINI_API_KEY empty = demo mode: real HTTP, DB, SSE; mock LLM text) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback when primary Gemini model fails (e.g. gemini-2.5-flash)
GEMINI_FALLBACK_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Retry transient LLM/embedding errors (429, 503, timeouts) before model failover
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8.0

# --- RAG ---
# false = hybrid: no relevant KB hit → LLM uses general knowledge
# true = strict: no relevant KB hit → refuse without calling the LLM
RAG_STRICT_MODE=false
# Max cosine distance for a chunk to count as relevant (lower = stricter matching)
RAG_MAX_DISTANCE=0.45

# --- JWT & session ---
JWT_SECRET_KEY=change-me-in-production-min-32-chars!!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Rate limits ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=120

# --- Session cookie (HttpOnly; Redis stores session_id → user_id) ---
SESSION_COOKIE_NAME=session_id
COOKIE_SAMESITE=lax
