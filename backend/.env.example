# App
APP_NAME=AI Chat
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
POSTGRES_USER=ai_chat
POSTGRES_PASSWORD=ai_chat_pass
POSTGRES_DB=ai_chat
DATABASE_URL=postgresql+asyncpg://ai_chat:ai_chat_pass@postgres:5432/ai_chat

# Redis
REDIS_URL=redis://redis:6379/0

# LLM (leave GEMINI_API_KEY empty to run in demo/mock streaming mode)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini (used by Docker Compose for the API container). This file is gitignored — do not commit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# Rate limit
RATE_LIMIT_PER_MINUTE=30
